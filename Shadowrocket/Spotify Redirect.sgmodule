#!name = Spotify Redirect
#!desc = 微信内点击 Spotify 链接由 Shadowrocket 推送跳转横幅直达 App。需开启 HTTPS 解密 (MitM)。

[MITM]
hostname = %APPEND% open.spotify.com, spotify.app.link

[Script]
Spotify Redirect = type=http-response,pattern=^https?:\/\/(open\.spotify\.com|spotify\.app\.link)\/(track|album|artist|playlist|show|episode|[a-zA-Z0-9_\-]+),requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/Stingraphic/DlerCloud/refs/heads/main/Shadowrocket/Spotify%20Redirect.js