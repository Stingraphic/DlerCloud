#!name = Spotify Redirect
#!desc = 修复微信内打开 Spotify 变成桌面端的问题，伪装为原生 iPhone Safari 请求，并触发跳转。需开启 HTTPS 解密 (MitM)。

[MITM]
hostname = %APPEND% open.spotify.com

[Header Rewrite]
# 将微信访问 open.spotify.com 时的 User-Agent 强行替换为原生 iPhone Safari 移动端 UA
^https?:\/\/open\.spotify\.com\/(track|album|artist|playlist|show|episode) header-replace User-Agent "Mozilla/5.0 (iPhone; CPU iPhone OS 18_0 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/18.0 Mobile/15E148 Safari/604.1"

[Script]
Spotify Redirect = type=http-response,pattern=^https?:\/\/open\.spotify\.com\/(track|album|artist|playlist)\/[a-zA-Z0-9]+,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/Stingraphic/DlerCloud/refs/heads/main/Shadowrocket/Spotify%20Redirect.js