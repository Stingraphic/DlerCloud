#!name =  Spotify Redirect
#!desc = 单文件独立模块。仅在微信安全跳转页中提取并自动唤醒 Spotify App，其他链接原样放行。需开启 HTTPS 解密 (MitM)。

[MITM]
hostname = %APPEND% security.wechat.com, weixin110.qq.com

[Script]
# 内联 Base64 脚本：精准嗅探微信安全页中的 Spotify 目标链接并强制唤醒，非 Spotify 链接原样放行
SpotifyWeChat = type=http-response,pattern=^https:\/\/(weixin110\.qq|security\.wechat)\.com\/cgi-bin\/mmspamsupport-bin\/newredirectconfirmcgi\?,requires-body=1,max-size=0,script-path=data:text/javascript;base64,
