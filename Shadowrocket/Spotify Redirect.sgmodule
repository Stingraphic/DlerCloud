#!name = Spotify Redirect
#!desc = 仅针对微信内打开 Spotify 链接时自动触发 Scheme 唤醒 App。需开启 HTTPS 解密 (MitM)。

[MITM]
hostname = %APPEND% open.spotify.com

[URL Rewrite]
# 仅针对 Spotify 的歌曲/专辑/歌手/歌单/播客链接生效，直接返回轻量跳转代码
^https?:\/\/open\.spotify\.com\/(track|album|artist|playlist|show|episode)\/([a-zA-Z0-9]+).* echo-response text/html data:text/html;charset=utf-8,<!DOCTYPE html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title>正在打开 Spotify</title></head><body style="background:#121212;color:#fff;display:flex;align-items:center;justify-content:center;height:80vh;font-family:-apple-system,sans-serif"><a id="btn" href="spotify://$1/$2" style="background:#1DB954;color:#fff;padding:12px 28px;border-radius:24px;text-decoration:none;font-weight:bold">打开 Spotify</a><script>(function(){var isWx=/micromessenger/i.test(navigator.userAgent);if(isWx){setTimeout(function(){var a=document.getElementById('btn');a.click();window.location.href='spotify://$1/$2';},50);}})();</script></body></html>
