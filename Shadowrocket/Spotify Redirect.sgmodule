#!name = WeChat to Spotify
#!desc = 无需额外 JS 文件，微信点击 Spotify 链接时直接返回轻量跳转页唤起 App。需开启 HTTPS 解密 (MitM) 并信任证书。

[MITM]
hostname = %APPEND% open.spotify.com

[URL Rewrite]
# 当微信请求 Spotify 链接时，直接就地返回包含自动唤醒脚本的 HTML 中间页
^https?:\/\/open\.spotify\.com\/(track|album|artist|playlist|show|episode)\/([a-zA-Z0-9]+).* echo-response text/html data:text/html;charset=utf-8,<!DOCTYPE html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title>打开 Spotify</title><style>body{background:#121212;color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;height:80vh;font-family:-apple-system,sans-serif}.btn{background:#1DB954;color:#fff;padding:12px 30px;border-radius:25px;text-decoration:none;font-weight:bold;margin-top:20px}</style></head><body><h3>正在前往 Spotify App...</h3><a id="go" class="btn" href="spotify://$1/$2">立即打开</a><script>setTimeout(function(){var a=document.getElementById('go');a.click();window.location.href='spotify://$1/$2';},100);</script></body></html>
