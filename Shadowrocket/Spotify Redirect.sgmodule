#!name = Spotify Redirect
#!desc = 提取自 zZPiglet 原版微信解封机制，完整整合在单文件中。仅当链接包含 open.spotify.com 时自动调用微信底层接口唤醒默认浏览器，其他链接原样放行。

[MITM]
hostname = %APPEND% security.wechat.com, weixin110.qq.com

[Script]
UnblockSpotifyInWeChat = type=http-response,pattern=^https:\/\/(weixin110\.qq|security\.wechat)\.com\/cgi-bin\/mmspamsupport-bin\/newredirectconfirmcgi\?,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/Stingraphic/DlerCloud/refs/heads/main/Shadowrocket/Spotify%20Redirect.js
