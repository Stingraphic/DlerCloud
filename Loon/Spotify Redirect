#!name = Spotify 微信跳转
#!desc = 在微信内打开 Spotify 链接时展示高质感暗黑原生卡片，并自动发送系统横幅通知直达 App。
#!author = Sting
#!icon = https://fastly.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Spotify.png

[MITM]
hostname = open.spotify.com, spotify.app.link

[Script]
# 直接写文件名，Loon 会自动在 iCloud 的 Loon/Scripts 目录中读取
http-response ^https?:\/\/(open\.spotify\.com|spotify\.app\.link)\/(track|album|artist|playlist|show|episode|[a-zA-Z0-9_\-]+) script-path=https://fastly.jsdelivr.net/gh/Stingraphic/DlerCloud@main/Shadowrocket/Spotify%20Redirect.js, requires-body=true, tag=SpotifyRedirect